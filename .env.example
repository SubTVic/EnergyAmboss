# Kopieren nach .env.local und ausfüllen. Ohne Supabase laufen B, C und D trotzdem;
# A nutzt dann das Platzhalter-Panel, E und das Feedback arbeiten im lokalen Probemodus.

# Supabase (Browser; der Anon-Key ist durch die Policies in supabase/schema.sql begrenzt)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 1 schaltet die optionale KI-Spielleitung in Prototyp D ein
VITE_LLM_JUDGE=0

# NUR Server (api/judge.ts). Niemals mit VITE_ beginnen, sonst landet der Schlüssel im Browser.
ANTHROPIC_API_KEY=
# Optional: anderes Modell für die KI-Spielleitung (Standard: claude-haiku-5-5)
JUDGE_MODEL=

# Projektwand (/wand): Bilderkennung über api/_wallRead.ts. Nutzt ANTHROPIC_API_KEY von oben.
# Optional: anderes Modell (Standard: claude-opus-5-5)
WALL_MODEL=
